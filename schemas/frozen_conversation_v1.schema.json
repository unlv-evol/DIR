{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validated first-generation conversation record",
  "type": "object",
  "required": ["schema_version", "methodology_version", "record_version", "case_id", "record_status", "conversation_start_time", "first_generation_cutoff", "primary_repository_cutoff", "first_snippet_family_id", "first_generation_response_id", "target_prompt_id", "allowed_prior_turn_ids", "context_supplied", "specificity_supplied", "verification_supplied", "extraction_version", "validation_status", "validation_judgments"],
  "properties": {
    "schema_version": {"const": "1"},
    "methodology_version": {"const": "dir-tfg-v1"},
    "record_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "record_status": {"const": "frozen"},
    "conversation_start_time": {"$ref": "#/$defs/anchor"},
    "first_generation_cutoff": {"$ref": "#/$defs/anchor"},
    "primary_repository_cutoff": {"const": "tFG"},
    "first_snippet_family_id": {"type": "string", "minLength": 1},
    "first_generation_response_id": {"type": "string", "minLength": 1},
    "target_prompt_id": {"type": "string", "minLength": 1},
    "target_prompt": {"type": "string"},
    "allowed_prior_turn_ids": {"type": "array", "items": {"type": "string"}},
    "allowed_prior_conversation": {"type": "array", "items": {"type": "object"}},
    "context_supplied": {"$ref": "#/$defs/items"},
    "specificity_supplied": {"$ref": "#/$defs/items"},
    "verification_supplied": {"$ref": "#/$defs/items"},
    "extraction_version": {"type": "string"},
    "validation_status": {"const": "validated"},
    "validation_judgments": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["validator_id", "boundary_correct", "target_prompt_correct", "item_supported", "category_assignment_correct", "provenance_correct", "future_information_leakage"],
      "properties": {"validator_id": {"type": "string"}, "boundary_correct": {"type": "boolean"},
        "target_prompt_correct": {"type": "boolean"}, "item_supported": {"type": "boolean"},
        "category_assignment_correct": {"type": "boolean"}, "provenance_correct": {"type": "boolean"},
        "future_information_leakage": {"type": "boolean"},
        "items": {"type": "array", "items": {"type": "object",
          "required": ["item_id", "supported", "category_assignment_correct", "provenance_correct", "future_information_leakage"],
          "properties": {"item_id": {"type": "string"}, "supported": {"type": "boolean"},
            "category_assignment_correct": {"type": "boolean"},
            "provenance_correct": {"type": "boolean"},
            "future_information_leakage": {"type": "boolean"}}}}}}}
  },
  "$defs": {
    "anchor": {"type": "object", "required": ["value", "precision", "status", "source"],
      "properties": {"value": {"type": "string"}, "precision": {"enum": ["timestamp", "date", ""]},
        "status": {"enum": ["exact", "derivable", "uncertain", "unresolved", "unavailable"]},
        "source": {"type": "string"}}},
    "items": {"type": "array", "items": {"type": "object", "required": ["item_id", "category", "text", "source_turn_id"],
      "properties": {"item_id": {"type": "string"}, "category": {"enum": ["Context", "Specificity", "Verification"]},
        "source_turn_id": {"type": "string"}, "text": {"type": "string"}, "source_span": {"type": "string"}}}}
  }
}
