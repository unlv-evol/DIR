{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-state-acquisition-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "reconstruction_contract",
    "procedure_version",
    "case_id",
    "repository",
    "pr",
    "tC",
    "tFG",
    "b1",
    "b2",
    "b3",
    "b4",
    "b5_support",
    "patchprompt_archive_repository_state_used",
    "candidate_R_i_tFG",
    "authoritative_R_i_tFG",
    "target_identity_status",
    "derivation_method",
    "conflicts",
    "materialization_status",
    "object_validation",
    "tree_validation",
    "tree_identity",
    "historical_state_reconstructible",
    "scientific_reason",
    "infrastructure_reason",
    "human_adjudication_required",
    "executed"
  ],
  "properties": {
    "record_version": {
      "const": "historical-state-acquisition-v3"
    },
    "reconstruction_contract": {
      "const": "post-stage-c-reconstruction-v3"
    },
    "procedure_version": {
      "const": "post-stage-c-b1-b2-pilot-v3"
    },
    "case_id": {
      "pattern": "^CASE_[0-9A-F]{12}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "identity_role",
        "created_at",
        "existed_by_tFG"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "identity_role": {
          "const": "case_provenance_only"
        },
        "created_at": {
          "type": "string"
        },
        "existed_by_tFG": {
          "type": "boolean"
        }
      }
    },
    "tC": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "source"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "timestamp",
            "date"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tFG": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "source"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "timestamp",
            "date"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "b1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "candidates"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_established",
            "established",
            "ambiguous"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "identifier",
              "identifier_type",
              "source_turn_or_artifact",
              "source_role",
              "exact_evidence",
              "focal_task_linkage",
              "temporal_admissibility",
              "ambiguity",
              "interpretation"
            ],
            "properties": {
              "identifier": {
                "type": "string",
                "pattern": "^[0-9a-f]{7,40}$"
              },
              "identifier_type": {
                "enum": [
                  "full_commit_sha",
                  "abbreviated_commit_sha"
                ]
              },
              "source_turn_or_artifact": {
                "type": "string",
                "minLength": 1
              },
              "source_role": {
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "exact_evidence": {
                "type": "string",
                "minLength": 1
              },
              "focal_task_linkage": {
                "enum": [
                  "established",
                  "unresolved"
                ]
              },
              "temporal_admissibility": {
                "const": "admissible_pre_tFG"
              },
              "ambiguity": {
                "type": "string"
              },
              "interpretation": {
                "enum": [
                  "identified_baseline_revision",
                  "identified_focal_change_revision",
                  "explicit_revision_semantics_unresolved"
                ]
              }
            }
          }
        }
      }
    },
    "b2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "required",
        "starting_revision",
        "starting_revision_source",
        "relationship_type",
        "relationship_result",
        "derivation",
        "derivation_validated"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_attempted",
            "validated",
            "unresolved"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "starting_revision": {
          "type": "string"
        },
        "starting_revision_source": {
          "const": "B1"
        },
        "relationship_type": {
          "enum": [
            "",
            "first_parent"
          ]
        },
        "relationship_result": {
          "type": "string"
        },
        "derivation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "derivation_validated": {
          "type": "boolean"
        }
      }
    },
    "b3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "not_used_v3"
        }
      }
    },
    "b4": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "const": "not_used_v3"
        }
      }
    },
    "b5_support": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "purpose",
          "observation_time",
          "supporting_only"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "observation_time": {
            "type": "string"
          },
          "supporting_only": {
            "const": true
          }
        }
      }
    },
    "patchprompt_archive_repository_state_used": {
      "const": false
    },
    "candidate_R_i_tFG": {
      "type": "string"
    },
    "authoritative_R_i_tFG": {
      "type": "string"
    },
    "target_identity_status": {
      "enum": [
        "unresolved",
        "established",
        "ambiguous"
      ]
    },
    "derivation_method": {
      "type": "string"
    },
    "conflicts": {
      "type": "array"
    },
    "materialization_status": {
      "enum": [
        "not_attempted",
        "materialized",
        "failed",
        "unresolved"
      ]
    },
    "object_validation": {
      "enum": [
        "not_attempted",
        "validated",
        "failed",
        "unresolved"
      ]
    },
    "tree_validation": {
      "enum": [
        "not_attempted",
        "validated",
        "failed",
        "unresolved"
      ]
    },
    "tree_identity": {
      "type": "string"
    },
    "historical_state_reconstructible": {
      "enum": [
        "yes",
        "no",
        "unresolved"
      ]
    },
    "scientific_reason": {
      "type": "string"
    },
    "infrastructure_reason": {
      "type": "string"
    },
    "human_adjudication_required": {
      "type": "boolean"
    },
    "executed": {
      "type": "boolean"
    }
  }
}
