{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-information-boundary-v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundary_record_version",
    "reconstruction_contract",
    "case_id",
    "tFG",
    "repository",
    "pr_existed_by_tFG",
    "authoritative_R_i_tFG",
    "target_identity_status",
    "b1_status",
    "b2_status",
    "b3_status",
    "b4_status",
    "patchprompt_archive_repository_state_used",
    "materialization_status",
    "object_validation",
    "tree_validation",
    "tree_identity",
    "historical_state_reconstructible",
    "provenance_references"
  ],
  "properties": {
    "boundary_record_version": {
      "const": "historical-information-boundary-v3"
    },
    "reconstruction_contract": {
      "const": "post-stage-c-reconstruction-v3"
    },
    "case_id": {
      "pattern": "^CASE_[0-9A-F]{12}$"
    },
    "tFG": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "precision",
        "source"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "timestamp",
            "date"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "string"
    },
    "pr_existed_by_tFG": {
      "type": "boolean"
    },
    "authoritative_R_i_tFG": {
      "type": "string"
    },
    "target_identity_status": {
      "enum": [
        "unresolved",
        "established",
        "ambiguous"
      ]
    },
    "b1_status": {
      "enum": [
        "not_established",
        "established",
        "ambiguous"
      ]
    },
    "b2_status": {
      "enum": [
        "not_attempted",
        "validated",
        "unresolved"
      ]
    },
    "b3_status": {
      "const": "not_used_v3"
    },
    "b4_status": {
      "const": "not_used_v3"
    },
    "patchprompt_archive_repository_state_used": {
      "const": false
    },
    "materialization_status": {
      "enum": [
        "not_attempted",
        "materialized",
        "failed",
        "unresolved"
      ]
    },
    "object_validation": {
      "enum": [
        "not_attempted",
        "validated",
        "failed",
        "unresolved"
      ]
    },
    "tree_validation": {
      "enum": [
        "not_attempted",
        "validated",
        "failed",
        "unresolved"
      ]
    },
    "tree_identity": {
      "type": "string"
    },
    "historical_state_reconstructible": {
      "enum": [
        "yes",
        "no",
        "unresolved"
      ]
    },
    "provenance_references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
