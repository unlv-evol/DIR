{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "conversation_draft_v2.schema.json",
  "title": "DIR Protocol v5 Stage C extraction record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "methodology_version", "extraction_version", "record_status", "case_id", "input", "first_generation", "temporal", "admissible_prior_turns", "context_supplied", "specificity_supplied", "verification_supplied", "model_provenance", "scientific_status", "status"],
  "$defs": {
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "precision", "status", "source", "derivation_rule"],
      "properties": {
        "value": {"type": "string"}, "precision": {"enum": ["", "date", "timestamp"]},
        "status": {"enum": ["exact", "derivable", "unresolved", "unavailable"]},
        "source": {"type": "string"}, "derivation_rule": {"type": "string"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "category", "text", "source_turns", "source_roles", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["context", "specificity", "verification"]},
        "text": {"type": "string", "minLength": 1},
        "source_turns": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_roles": {"type": "array", "items": {"enum": ["user", "assistant"]}, "minItems": 1},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "conversation-draft-v2"},
    "methodology_version": {"const": "dir-tfg-v2"},
    "extraction_version": {"const": "conversation-extraction-v2"},
    "record_status": {"const": "draft"},
    "case_id": {"type": "string", "pattern": "^CASE_[0-9A-F]{12}$"},
    "input": {"type": "object", "additionalProperties": false, "required": ["stage_b_model_view_ref", "sha256"], "properties": {"stage_b_model_view_ref": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "first_generation": {"type": "object", "additionalProperties": false, "required": ["status", "family_id", "artifact_refs", "response_turn_id", "response_event_index", "target_prompt_id", "target_prompt_event_index", "boundary", "candidate_artifact_ids", "rationale", "ambiguity_reason"], "properties": {
      "status": {"enum": ["complete", "ambiguous", "unresolved", "failed"]}, "family_id": {"type": "string"},
      "artifact_refs": {"type": "array", "items": {"type": "string"}}, "response_turn_id": {"type": "string"},
      "response_event_index": {"type": ["integer", "null"]}, "target_prompt_id": {"type": "string"},
      "target_prompt_event_index": {"type": ["integer", "null"]}, "boundary": {"type": "string"},
      "candidate_artifact_ids": {"type": "array", "items": {"type": "string"}}, "rationale": {"type": "string"}, "ambiguity_reason": {"type": "string"}
    }},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["tC", "tFG", "primary_repository_cutoff"], "properties": {"tC": {"$ref": "#/$defs/anchor"}, "tFG": {"$ref": "#/$defs/anchor"}, "primary_repository_cutoff": {"const": "tFG"}}},
    "admissible_prior_turns": {"type": "array", "items": {"type": "object"}},
    "context_supplied": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "specificity_supplied": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "verification_supplied": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "model_provenance": {"type": "object"},
    "scientific_status": {"type": "object", "additionalProperties": false, "required": ["eligibility_updated", "post_stage_c_resolution_required"], "properties": {"eligibility_updated": {"const": false}, "post_stage_c_resolution_required": {"const": true}}},
    "status": {"type": "object", "additionalProperties": false, "required": ["stage_c_status", "parser_status", "validation_status", "failure_reason"], "properties": {"stage_c_status": {"enum": ["complete", "ambiguous", "unresolved", "failed"]}, "parser_status": {"enum": ["parsed", "not_run", "malformed"]}, "validation_status": {"enum": ["validated", "not_validated", "failed"]}, "failure_reason": {"type": "string"}}}
  }
}
