{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical repository-state acquisition record",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_record_version", "reconstruction_contract_version", "eligibility_contract_version", "methodology_version", "case_id", "repository", "pull_request", "stage_c_authority", "temporal", "target_selection", "attempts", "object_validation", "components", "reconstruction_status", "failure_category", "failure_reason", "retry_disposition", "historical_state_reconstructible", "scientific_basis", "notes"],
  "properties": {
    "attempt_record_version": {"const": "historical-state-acquisition-v1"},
    "reconstruction_contract_version": {"const": "post-stage-c-reconstruction-v1"},
    "eligibility_contract_version": {"const": "post-stage-c-eligibility-v1"},
    "methodology_version": {"const": "dir-tfg-v2"},
    "case_id": {"type": "string", "pattern": "^CASE_[0-9A-F]{12}$"},
    "repository": {"type": "object", "additionalProperties": false, "required": ["identity", "canonical_url"], "properties": {"identity": {"type": "string"}, "canonical_url": {"type": "string"}}},
    "pull_request": {"type": "object", "additionalProperties": false, "required": ["number", "source_linkage_reference"], "properties": {"number": {"type": "integer", "minimum": 1}, "source_linkage_reference": {"type": "string"}}},
    "stage_c_authority": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "temporal": {"type": "object", "additionalProperties": false, "required": ["tC", "tFG", "primary_repository_cutoff", "comparison_rule"], "properties": {"tC": {"$ref": "#/$defs/anchor"}, "tFG": {"$ref": "#/$defs/anchor"}, "primary_repository_cutoff": {"const": "tFG"}, "comparison_rule": {"const": "historical_timestamp_lte_tFG"}}},
    "target_selection": {"type": "object", "additionalProperties": false, "required": ["rule", "type", "candidate_identifiers", "authoritative_identifier", "identity_status", "identity_basis", "historical_identity_evidence", "temporal_evidence", "adjudication"], "properties": {"rule": {"const": "historically_evidenced_focal_pr_base_state_at_tFG"}, "type": {"const": "git_commit"}, "candidate_identifiers": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"}, "uniqueItems": true}, "authoritative_identifier": {"type": "string"}, "identity_status": {"enum": ["candidate_only", "established", "ambiguous", "unresolved"]}, "identity_basis": {"type": "string"}, "historical_identity_evidence": {"type": "array", "items": {"$ref": "#/$defs/targetIdentityClaim"}}, "temporal_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "adjudication": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/adjudication"}]}}},
    "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "object_validation": {"type": "object", "additionalProperties": false, "required": ["object_sha", "object_type", "parent_shas", "tree_sha", "relationships_validated", "deterministic_repeat_validated", "materialized_state_identifier"], "properties": {"object_sha": {"type": "string"}, "object_type": {"type": "string"}, "parent_shas": {"type": "array", "items": {"type": "string"}}, "tree_sha": {"type": "string"}, "relationships_validated": {"type": "boolean"}, "deterministic_repeat_validated": {"type": "boolean"}, "materialized_state_identifier": {"type": "string"}}},
    "components": {"type": "object", "additionalProperties": false, "required": ["repository", "pr", "issue", "ci", "discussion"], "properties": {"repository": {"$ref": "#/$defs/component"}, "pr": {"$ref": "#/$defs/component"}, "issue": {"$ref": "#/$defs/component"}, "ci": {"$ref": "#/$defs/component"}, "discussion": {"$ref": "#/$defs/component"}}},
    "reconstruction_status": {"enum": ["not_attempted", "target_identified", "materialized_validated", "unresolved", "failed"]},
    "failure_category": {"$ref": "post_stage_c_eligibility_v1.schema.json#/$defs/failureCategory"},
    "failure_reason": {"type": "string"},
    "retry_disposition": {"enum": ["not_applicable", "retry_allowed", "retry_exhausted", "retry_prohibited"]},
    "historical_state_reconstructible": {"enum": ["yes", "no", "unresolved"]},
    "scientific_basis": {"type": "string"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "anchor": {"type": "object", "additionalProperties": false, "required": ["value", "precision", "status", "source"], "properties": {"value": {"type": "string"}, "precision": {"enum": ["date", "timestamp"]}, "status": {"enum": ["exact", "derivable", "unresolved", "unavailable", "uncertain"]}, "source": {"type": "string"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source", "historical_timestamp", "timestamp_precision", "temporal_relation_to_tFG", "provenance_ref"], "properties": {"evidence_id": {"type": "string"}, "source": {"type": "string"}, "historical_timestamp": {"type": "string"}, "timestamp_precision": {"enum": ["date", "timestamp", "unavailable"]}, "temporal_relation_to_tFG": {"enum": ["at_or_before", "after", "unresolved", "unavailable"]}, "provenance_ref": {"type": "string"}}},
    "targetIdentityClaim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "evidence_level", "evidence_source_type", "evidence_source_identifier", "evidence_historical_timestamp", "evidence_timestamp_precision", "evidence_relation_to_tFG", "retrieval_timestamp", "evidence_hash", "provenance_reference", "asserted_base_sha", "evidence_status", "adequate_provenance", "cross_validated"], "properties": {"claim_id": {"type": "string", "minLength": 1}, "evidence_level": {"enum": ["level_1_direct_historical_pr_state", "level_2_derivable_immutable_historical_relationship", "level_3_contemporaneous_provider", "level_4_present_day_pr_metadata", "level_5_present_day_git_object_or_ref"]}, "evidence_source_type": {"type": "string", "minLength": 1}, "evidence_source_identifier": {"type": "string", "minLength": 1}, "evidence_historical_timestamp": {"type": "string"}, "evidence_timestamp_precision": {"enum": ["date", "timestamp", "unavailable"]}, "evidence_relation_to_tFG": {"enum": ["at_or_before", "after", "unresolved", "unavailable"]}, "retrieval_timestamp": {"type": "string"}, "evidence_hash": {"type": "string"}, "provenance_reference": {"type": "string", "minLength": 1}, "asserted_base_sha": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{40,64}$"}, "evidence_status": {"enum": ["accepted", "rejected", "unresolved", "supporting_only"]}, "adequate_provenance": {"type": "boolean"}, "cross_validated": {"type": "boolean"}}},
    "adjudication": {"type": "object", "additionalProperties": false, "required": ["case_id", "candidate_states", "evidence_references", "hierarchy_levels", "decision", "selected_target_identifier", "rationale", "adjudicator_status", "timestamp", "contract_version", "decision_basis"], "properties": {"case_id": {"type": "string", "pattern": "^CASE_[0-9A-F]{12}$"}, "candidate_states": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"}}, "evidence_references": {"type": "array", "items": {"type": "string"}}, "hierarchy_levels": {"type": "array", "items": {"type": "string"}}, "decision": {"enum": ["select", "ambiguous", "unresolved"]}, "selected_target_identifier": {"type": "string"}, "rationale": {"type": "string"}, "adjudicator_status": {"enum": ["independent", "reconciled"]}, "timestamp": {"type": "string", "format": "date-time"}, "contract_version": {"const": "post-stage-c-reconstruction-v1"}, "decision_basis": {"enum": ["hierarchy_rank", "provenance_quality", "deterministic_derivation"]}}},
    "attempt": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "attempt_number", "started_at", "completed_at", "acquisition_source", "operations", "exit_status", "stdout_ref", "stderr_ref", "retrieval_timestamp", "failure_category", "retry_disposition"], "properties": {"attempt_id": {"type": "string"}, "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "acquisition_source": {"type": "string"}, "operations": {"type": "array", "items": {"type": "string"}}, "exit_status": {"type": "integer"}, "stdout_ref": {"type": "string"}, "stderr_ref": {"type": "string"}, "retrieval_timestamp": {"type": "string", "format": "date-time"}, "failure_category": {"type": "string"}, "retry_disposition": {"type": "string"}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["status", "evidence_refs"], "properties": {"status": {"enum": ["not_assessed", "available", "unavailable", "unresolved", "not_applicable"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}}
  }
}
