{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-Stage-C final eligibility manifest logical row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "reconstruction_contract_version",
    "reconstruction_procedure_version",
    "eligibility_contract_version",
    "methodology_version",
    "case_id",
    "stage_c_processability_status",
    "stage_c_authoritative_record",
    "stage_c_authoritative_record_sha256",
    "stage_c_authority_validation_status",
    "tC",
    "tC_precision",
    "tC_status",
    "tC_source",
    "tFG",
    "tFG_precision",
    "tFG_status",
    "tFG_source",
    "primary_repository_cutoff",
    "first_generation_boundary_identifiable",
    "first_generation_boundary_basis",
    "repository",
    "canonical_repository_url",
    "pr_number",
    "source_linkage_reference",
    "reconstruction_target_rule",
    "reconstruction_target_type",
    "candidate_target_identifier",
    "authoritative_target_identifier",
    "target_identity_status",
    "target_identity_basis",
    "historical_availability_status",
    "historical_availability_basis",
    "historical_state_reconstructible",
    "repository_component_status",
    "pr_component_status",
    "issue_component_status",
    "ci_component_status",
    "discussion_component_status",
    "reconstruction_status",
    "reconstruction_attempt_id",
    "reconstruction_evidence_ref",
    "reconstruction_log_ref",
    "reconstruction_authority_ref",
    "failure_category",
    "failure_reason",
    "retry_disposition",
    "remaining_criteria_status",
    "final_scientific_eligibility",
    "exclusion_reason",
    "adjudication_required",
    "notes"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": "post-stage-c-eligibility-manifest-v2"
    },
    "reconstruction_contract_version": {
      "const": "post-stage-c-reconstruction-v4"
    },
    "reconstruction_procedure_version": {
      "const": "post-stage-c-git-lineage-v4"
    },
    "eligibility_contract_version": {
      "const": "post-stage-c-eligibility-v2"
    },
    "methodology_version": {
      "const": "dir-tfg-v2"
    },
    "case_id": {
      "type": "string",
      "pattern": "^CASE_[0-9A-F]{12}$"
    },
    "stage_c_processability_status": {
      "const": "processable"
    },
    "stage_c_authoritative_record": {
      "type": "string",
      "minLength": 1
    },
    "stage_c_authoritative_record_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stage_c_authority_validation_status": {
      "const": "validated"
    },
    "tC": {
      "type": "string",
      "minLength": 1
    },
    "tC_precision": {
      "$ref": "#/$defs/precision"
    },
    "tC_status": {
      "$ref": "#/$defs/temporalStatus"
    },
    "tC_source": {
      "type": "string",
      "minLength": 1
    },
    "tFG": {
      "type": "string",
      "minLength": 1
    },
    "tFG_precision": {
      "$ref": "#/$defs/precision"
    },
    "tFG_status": {
      "$ref": "#/$defs/temporalStatus"
    },
    "tFG_source": {
      "type": "string",
      "minLength": 1
    },
    "primary_repository_cutoff": {
      "const": "tFG"
    },
    "first_generation_boundary_identifiable": {
      "enum": [
        "yes",
        "no",
        "unresolved"
      ]
    },
    "first_generation_boundary_basis": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "canonical_repository_url": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+$"
    },
    "pr_number": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "source_linkage_reference": {
      "type": "string",
      "minLength": 1
    },
    "reconstruction_target_rule": {
      "const": "historical_repository_state_at_tFG",
      "description": "S_i(tFG), the reconstructed historical repository state applicable to the focal development task at the authoritative first-generation cutoff."
    },
    "reconstruction_target_type": {
      "const": "git_commit"
    },
    "candidate_target_identifier": {
      "type": "string",
      "pattern": "^$|^[0-9a-fA-F]{40,64}$"
    },
    "authoritative_target_identifier": {
      "type": "string",
      "pattern": "^$|^[0-9a-fA-F]{40,64}$"
    },
    "target_identity_status": {
      "enum": [
        "candidate_only",
        "established",
        "ambiguous",
        "unresolved"
      ]
    },
    "target_identity_basis": {
      "type": "string"
    },
    "historical_availability_status": {
      "enum": [
        "not_assessed",
        "at_or_before",
        "after",
        "unresolved",
        "unavailable"
      ]
    },
    "historical_availability_basis": {
      "type": "string"
    },
    "historical_state_reconstructible": {
      "enum": [
        "yes",
        "no",
        "unresolved"
      ]
    },
    "repository_component_status": {
      "$ref": "#/$defs/componentStatus"
    },
    "pr_component_status": {
      "$ref": "#/$defs/componentStatus"
    },
    "issue_component_status": {
      "$ref": "#/$defs/componentStatus"
    },
    "ci_component_status": {
      "$ref": "#/$defs/componentStatus"
    },
    "discussion_component_status": {
      "$ref": "#/$defs/componentStatus"
    },
    "reconstruction_status": {
      "enum": [
        "reconstructed_focal_state",
        "reconstructed_base_state",
        "unresolved"
      ]
    },
    "reconstruction_attempt_id": {
      "type": "string"
    },
    "reconstruction_evidence_ref": {
      "type": "string"
    },
    "reconstruction_log_ref": {
      "type": "string"
    },
    "reconstruction_authority_ref": {
      "type": "string",
      "minLength": 1
    },
    "failure_category": {
      "$ref": "#/$defs/failureCategory"
    },
    "failure_reason": {
      "type": "string"
    },
    "retry_disposition": {
      "enum": [
        "not_applicable",
        "retry_allowed",
        "retry_exhausted",
        "retry_prohibited"
      ]
    },
    "remaining_criteria_status": {
      "enum": [
        "historical_state_reconstructible_unresolved",
        "all_satisfied",
        "failed",
        "unresolved"
      ]
    },
    "final_scientific_eligibility": {
      "enum": [
        "eligible",
        "excluded",
        "pending_resolution"
      ]
    },
    "exclusion_reason": {
      "type": "string"
    },
    "adjudication_required": {
      "enum": [
        "true",
        "false"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "precision": {
      "enum": [
        "date",
        "timestamp"
      ]
    },
    "temporalStatus": {
      "enum": [
        "exact",
        "derivable",
        "unresolved",
        "unavailable",
        "uncertain"
      ]
    },
    "componentStatus": {
      "enum": [
        "not_assessed",
        "available",
        "unavailable",
        "unresolved",
        "not_applicable"
      ]
    },
    "failureCategory": {
      "enum": [
        "",
        "target_ambiguous",
        "identifier_missing",
        "temporal_relation_unresolved",
        "temporally_inadmissible",
        "object_not_found",
        "repository_unavailable",
        "authentication_blocked",
        "rate_limited",
        "transport_failed",
        "timed_out",
        "validation_failed",
        "scientifically_not_reconstructible"
      ]
    }
  }
}
