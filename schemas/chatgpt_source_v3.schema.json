{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt_source_v3.schema.json",
  "title": "DIR Stage B archived historical HTTP source",
  "type": "object",
  "additionalProperties": false,
  "required": ["archive_version", "case_id", "source_url", "final_url", "retrieved_at", "retrieval_status", "retrieval_time_status", "source_origin", "http_status", "content_type", "source_format", "parser_version", "source_sha256", "source_payload_base64", "archived_http_import", "normalization_status"],
  "properties": {
    "archive_version": {"const": "chatgpt-source-v3"},
    "case_id": {"type": "string", "pattern": "^CASE_[0-9A-F]{12}$"},
    "retrieved_at": {"type": "null"},
    "retrieval_status": {"const": "retrieved_public"},
    "retrieval_time_status": {"const": "unknown_archive_timezone"},
    "source_origin": {"const": "archived_http_response"},
    "http_status": {"const": 200},
    "content_type": {"const": "text/html"},
    "source_url": {"type": "string", "minLength": 1},
    "final_url": {"type": "string", "minLength": 1},
    "source_format": {"const": "next_data_html"},
    "parser_version": {"const": "screening-chatgpt-structured-v1"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_payload_base64": {"type": "string", "minLength": 1},
    "normalization_status": {"const": "parsed"},
    "archived_http_import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_path", "archive_sha256", "archive_member", "archive_snapshot_timestamp_raw", "archive_member_sha256", "source_index", "sharing_index", "embedded_field", "embedded_content_sha256", "source_format", "share_id", "canonical_share_url", "expected_pr_url", "source_dataset", "source_dataset_version", "original_vs_derived", "archived_http_status", "DateOfAccess_raw", "DateOfConversation_raw", "parser_version", "normalization_version", "selection_rule", "selection_reason", "qualifying_candidates", "imported_at"],
      "properties": {
        "archive_path": {"type": "string", "minLength": 1},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_member": {"type": "string", "minLength": 1},
        "archive_snapshot_timestamp_raw": {"type": "string", "pattern": "^[0-9]{8}_[0-9]{6}$"},
        "archive_member_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_index": {"type": "integer", "minimum": 0},
        "sharing_index": {"type": "integer", "minimum": 0},
        "embedded_field": {"const": "HTMLContent"},
        "embedded_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_format": {"const": "next_data_html"},
        "share_id": {"type": "string", "minLength": 1},
        "canonical_share_url": {"type": "string", "minLength": 1},
        "expected_pr_url": {"type": "string", "minLength": 1},
        "source_dataset": {"const": "PatchTrack allPullRequestSharings replication archive"},
        "source_dataset_version": {"type": ["string", "null"]},
        "original_vs_derived": {"const": "original_archived_http_response"},
        "archived_http_status": {"const": 200},
        "DateOfAccess_raw": {"type": ["string", "null"]},
        "DateOfConversation_raw": {"type": ["string", "null"]},
        "parser_version": {"const": "screening-chatgpt-structured-v1"},
        "normalization_version": {"const": "lossless-conversation-v1"},
        "selection_rule": {"const": "earliest-valid-exact-identity-v1"},
        "selection_reason": {"type": "string", "minLength": 1},
        "qualifying_candidates": {"type": "array", "minItems": 1},
        "imported_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
