{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Historical Project Information Space index",
  "type": "object",
  "additionalProperties": false,
  "required": ["historical_index_version", "reconstruction_contract_version", "methodology_version", "case_id", "tFG", "primary_repository_cutoff", "target_identity_claims", "components"],
  "properties": {
    "historical_index_version": {"const": "historical-information-index-v1"},
    "reconstruction_contract_version": {"const": "post-stage-c-reconstruction-v1"},
    "methodology_version": {"const": "dir-tfg-v2"},
    "case_id": {"type": "string", "pattern": "^CASE_[0-9A-F]{12}$"},
    "tFG": {"$ref": "#/$defs/anchor"},
    "primary_repository_cutoff": {"const": "tFG"},
    "target_identity_claims": {"type": "array", "items": {"$ref": "historical_state_acquisition_v1.schema.json#/$defs/targetIdentityClaim"}},
    "components": {"type": "object", "additionalProperties": false, "required": ["repository", "pr", "issue", "ci", "discussion"], "properties": {"repository": {"$ref": "#/$defs/component"}, "pr": {"$ref": "#/$defs/component"}, "issue": {"$ref": "#/$defs/component"}, "ci": {"$ref": "#/$defs/component"}, "discussion": {"$ref": "#/$defs/component"}}}
  },
  "$defs": {
    "anchor": {"type": "object", "additionalProperties": false, "required": ["value", "precision", "status", "source"], "properties": {"value": {"type": "string"}, "precision": {"enum": ["date", "timestamp"]}, "status": {"enum": ["exact", "derivable", "unresolved", "unavailable", "uncertain"]}, "source": {"type": "string"}}},
    "component": {"type": "object", "additionalProperties": false, "required": ["status", "items"], "properties": {"status": {"enum": ["not_assessed", "available", "unavailable", "unresolved", "not_applicable"]}, "items": {"type": "array", "items": {"$ref": "#/$defs/item"}}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["stable_identifier", "source_type", "source", "historical_timestamp", "timestamp_precision", "temporal_relation_to_tFG", "retrieval_timestamp", "provenance_reference", "availability_status"], "properties": {"stable_identifier": {"type": "string", "minLength": 1}, "source_type": {"enum": ["repository_object", "repository_history", "pull_request", "issue", "work_item", "review", "comment", "discussion", "ci_run", "ci_job", "ci_log"]}, "source": {"type": "string", "minLength": 1}, "historical_timestamp": {"type": "string"}, "timestamp_precision": {"enum": ["date", "timestamp", "unavailable"]}, "temporal_relation_to_tFG": {"enum": ["at_or_before", "after", "unresolved", "unavailable"]}, "retrieval_timestamp": {"type": "string"}, "provenance_reference": {"type": "string", "minLength": 1}, "availability_status": {"enum": ["available", "unavailable", "unresolved"]}}}
  }
}
