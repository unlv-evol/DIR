{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-information-boundary-v2",
  "title": "Post-Stage-C Historical Repository Boundary V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["boundary_record_version", "reconstruction_contract_version", "methodology_version", "case_id", "tC", "tFG", "primary_repository_cutoff", "repository", "pr_existed_by_tFG", "pr_component_status", "authoritative_R_i_tFG", "target_identity_status", "development_linkage_status", "temporal_applicability_status", "materialization_status", "object_validation_status", "tree_validation_status", "tree_identity", "historical_state_reconstructible", "provenance_references"],
  "properties": {
    "boundary_record_version": {"const": "historical-information-boundary-v2"},
    "reconstruction_contract_version": {"const": "post-stage-c-reconstruction-v2"},
    "methodology_version": {"const": "dir-tfg-v2"},
    "case_id": {"type": "string", "pattern": "^CASE_[0-9A-F]{12}$"},
    "tC": {"type": "object"}, "tFG": {"type": "object"},
    "primary_repository_cutoff": {"const": "tFG"},
    "repository": {"type": "string", "minLength": 3},
    "pr_existed_by_tFG": {"enum": ["yes", "no", "unresolved"]},
    "pr_component_status": {"enum": ["available_by_tFG", "unavailable_by_tFG", "unresolved"]},
    "authoritative_R_i_tFG": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{40,64}$"},
    "target_identity_status": {"enum": ["unresolved", "established", "ambiguous"]},
    "development_linkage_status": {"enum": ["unresolved", "established", "absent"]},
    "temporal_applicability_status": {"enum": ["unresolved", "at_or_before", "after"]},
    "materialization_status": {"enum": ["not_attempted", "materialized", "failed", "unresolved"]},
    "object_validation_status": {"enum": ["not_attempted", "validated", "failed", "unresolved"]},
    "tree_validation_status": {"enum": ["not_attempted", "validated", "failed", "unresolved"]},
    "tree_identity": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{40,64}$"},
    "historical_state_reconstructible": {"enum": ["yes", "no", "unresolved"]},
    "provenance_references": {"type": "array", "items": {"type": "string"}}
  }
}
