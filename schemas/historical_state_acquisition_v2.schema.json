{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historical-state-acquisition-v2",
  "title": "Post-Stage-C Development Baseline Acquisition V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_version", "reconstruction_contract_version", "methodology_version", "procedure_version", "case_id", "repository", "tC", "tFG", "primary_repository_cutoff", "pr", "target_rule", "candidate_repository_boundaries", "authoritative_R_i_tFG", "target_identity_status", "development_linkage_status", "temporal_applicability_status", "materialization_status", "object_validation_status", "tree_validation_status", "tree_identity", "historical_state_reconstructible", "scientific_reason", "operational_reason", "evidence_claims", "derivation_chain", "conflicts", "human_adjudication_status", "attempts", "executed"],
  "properties": {
    "record_version": {"const": "historical-state-acquisition-v2"},
    "reconstruction_contract_version": {"const": "post-stage-c-reconstruction-v2"},
    "methodology_version": {"const": "dir-tfg-v2"},
    "procedure_version": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^CASE_[0-9A-F]{12}$"},
    "repository": {"type": "string", "minLength": 3},
    "tC": {"$ref": "#/$defs/anchor"},
    "tFG": {"$ref": "#/$defs/anchor"},
    "primary_repository_cutoff": {"const": "tFG"},
    "pr": {"type": "object", "additionalProperties": false, "required": ["number", "created_at", "existed_by_tFG", "component_status"], "properties": {"number": {"type": "integer", "minimum": 1}, "created_at": {"type": "string"}, "existed_by_tFG": {"enum": ["yes", "no", "unresolved"]}, "component_status": {"enum": ["available_by_tFG", "unavailable_by_tFG", "unresolved"]}}},
    "target_rule": {"const": "historically_justified_development_repository_baseline_at_tFG"},
    "candidate_repository_boundaries": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"}, "uniqueItems": true},
    "authoritative_R_i_tFG": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{40,64}$"},
    "target_identity_status": {"enum": ["unresolved", "established", "ambiguous"]},
    "development_linkage_status": {"enum": ["unresolved", "established", "absent"]},
    "temporal_applicability_status": {"enum": ["unresolved", "at_or_before", "after"]},
    "materialization_status": {"enum": ["not_attempted", "materialized", "failed", "unresolved"]},
    "object_validation_status": {"enum": ["not_attempted", "validated", "failed", "unresolved"]},
    "tree_validation_status": {"enum": ["not_attempted", "validated", "failed", "unresolved"]},
    "tree_identity": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{40,64}$"},
    "historical_state_reconstructible": {"enum": ["yes", "no", "unresolved"]},
    "scientific_reason": {"type": "string"},
    "operational_reason": {"type": "string"},
    "evidence_claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "derivation_chain": {"type": "array", "items": {"type": "object"}},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "human_adjudication_status": {"enum": ["not_required", "required", "pending", "resolved"]},
    "attempts": {"type": "array", "items": {"type": "object"}},
    "executed": {"type": "boolean"}
  },
  "$defs": {
    "anchor": {"type": "object", "additionalProperties": false, "required": ["value", "precision", "status", "source"], "properties": {"value": {"type": "string", "minLength": 1}, "precision": {"enum": ["date", "timestamp"]}, "status": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "evidence_level", "candidate_sha", "source_identifier", "historical_source_timestamp", "timestamp_precision", "relation_to_tFG", "development_context_linkage", "derivation_rule", "derivation_inputs", "immutable_git_relationships", "validation_status", "evidence_hash", "provenance_reference", "adequate_provenance", "cross_validated", "uses_outcome_information"], "properties": {"claim_id": {"type": "string", "minLength": 1}, "evidence_level": {"enum": ["B1", "B2", "B3", "B4", "B5"]}, "candidate_sha": {"type": "string", "pattern": "^$|^[0-9a-fA-F]{40,64}$"}, "source_identifier": {"type": "string", "minLength": 1}, "historical_source_timestamp": {"type": "string"}, "timestamp_precision": {"enum": ["date", "timestamp", "unavailable"]}, "relation_to_tFG": {"enum": ["at_or_before", "after", "unresolved"]}, "development_context_linkage": {"enum": ["established", "unresolved", "absent"]}, "derivation_rule": {"type": "string"}, "derivation_inputs": {"type": "array", "items": {"type": "string"}}, "immutable_git_relationships": {"type": "array", "items": {"type": "string"}}, "validation_status": {"enum": ["validated", "unresolved", "rejected", "supporting_only"]}, "evidence_hash": {"type": "string"}, "provenance_reference": {"type": "string", "minLength": 1}, "adequate_provenance": {"type": "boolean"}, "cross_validated": {"type": "boolean"}, "uses_outcome_information": {"type": "boolean"}}}
  }
}
