# Copy to .env for local overrides. Never commit a real token.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=
DIR_HTTP_TIMEOUT=30
DIR_HTTP_RETRIES=3
DIR_V5_SCREENING_CACHE_DIR=data/intermediate/screening/cache/current
DIR_V5_SCREENING_OUTPUT=cases/manifests/screened_PA_PN_cases.csv

# OpenAI Stage C configuration. Keep the real key only in ignored .env.
OPENAI_API_KEY=
# Optional; omit to use the OpenAI SDK default endpoint.
OPENAI_API_BASE_URL=
# Non-secret research configuration; intended model: gpt-5.6-sol.
DIR_STAGE_C_MODEL=
DIR_STAGE_C_REASONING_MODE=standard
DIR_STAGE_C_REASONING_EFFORT=medium
DIR_STAGE_C_MAX_RETRIES=2
